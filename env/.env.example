# Copy to .env.dev. Use real values from your own environment.
# Plain KEY=value format; do not wrap values in quotes.
TEAMSFX_ENV=dev
TEAMS_APP_TENANT_ID=
FOUNDRY_OAUTH_CLIENT_ID=
FOUNDRY_PROJECT_ENDPOINT=
APP_DISPLAY_NAME=
DEVELOPER_NAME=
DEVELOPER_WEBSITE_URL=
DEVELOPER_PRIVACY_URL=
DEVELOPER_TERMS_URL=

# Generated by provisioning, or supplied from registrations you manage.
TEAMS_APP_ID=
FOUNDRY_OAUTH_REFERENCE_ID=

# Do not put a client secret in this file.
# Provisioning reads SECRET_FOUNDRY_OAUTH_CLIENT_SECRET from the process environment.
